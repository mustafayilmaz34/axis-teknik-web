---
import '../styles/global.css';
import { company, nav } from '../data/site';
import Icon from '../components/Icon.astro';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const fullTitle = title === company.name ? `${company.name} | ${company.tagline}` : `${title} | ${company.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/logo.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: company.name,
    url: Astro.site?.toString(),
    telephone: '+902163071862',
    email: company.email,
    foundingDate: String(company.founded),
    address: { '@type': 'PostalAddress', streetAddress: 'Velibaba Mah. Mimar Sinan Cad. San. Sit. B1 No:15/5-8', addressLocality: 'Pendik', addressRegion: 'İstanbul', addressCountry: 'TR' },
  })} />
</head>
<body class="flex min-h-screen flex-col pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0">
  <a href="#icerik" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">İçeriğe geç</a>

  <div class="hidden bg-brand-900 text-sm text-brand-100 md:block">
    <div class="container-x flex h-10 items-center justify-end gap-6">
      <a href={company.phone.href} class="flex items-center gap-2 hover:text-white"><Icon name="phone" class="size-4" />{company.phone.label}</a>
      <a href={company.whatsapp.href} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-white"><Icon name="whatsapp" class="size-4" />WhatsApp</a>
      <a href={`mailto:${company.email}`} class="flex items-center gap-2 hover:text-white"><Icon name="mail" class="size-4" />{company.email}</a>
    </div>
  </div>

  <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 shadow-sm shadow-brand-950/5 backdrop-blur">
    <div class="container-x flex h-20 items-center justify-between md:h-24">
      <a href="/" class="flex shrink-0 items-center gap-4" aria-label={`${company.name} ana sayfa`}>
        <img src="/logo-mark.png" alt="" width="708" height="223" class="h-12 w-auto md:h-14" fetchpriority="high" />
        <span class="hidden border-l-2 border-accent-500 pl-4 text-sm font-semibold leading-snug text-brand-900 xl:block">{company.logoTagline.map((l) => <span class="block">{l}</span>)}</span>
      </a>
      <nav aria-label="Ana menü" class="hidden items-center gap-8 md:flex">
        {nav.map((n) => (
          <a href={n.href} class:list={['font-medium hover:text-brand-700', path.startsWith(n.href) && 'text-brand-700']} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a href="/iletisim/#teklif-formu" class="btn-primary">Teklif Al</a>
      </nav>
      <details class="group md:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-300" aria-label="Menüyü aç"><Icon name="menu" /></summary>
        <nav aria-label="Mobil menü" class="absolute inset-x-0 top-20 border-b border-slate-200 bg-white shadow-lg">
          <ul class="container-x divide-y divide-slate-100 py-2">
            {nav.map((n) => <li><a href={n.href} class="block py-3 text-lg font-medium">{n.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </header>

  <main id="icerik" class="flex-1"><slot /></main>

  <footer class="bg-brand-950 text-brand-200">
    <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="font-heading text-xl font-bold text-white">{company.name}</p>
        <p class="mt-2 max-w-sm">{company.tagline}. {company.founded}'dan beri tasarım, uygulama, devreye alma ve bakım.</p>
      </div>
      <div>
        <p class="font-semibold text-white">Sayfalar</p>
        <ul class="mt-3 space-y-2">
          {nav.map((n) => <li><a href={n.href} class="hover:text-white">{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-semibold text-white">İletişim</p>
        <address class="mt-3 space-y-2 not-italic">
          <p>{company.address}</p>
          <p><a href={company.phone.href} class="hover:text-white">{company.phone.label}</a></p>
          <p><a href={company.whatsapp.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-white"><Icon name="whatsapp" class="size-4" />WhatsApp: {company.whatsapp.label}</a></p>
          <p><a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a></p>
        </address>
      </div>
    </div>
    <div class="border-t border-white/10">
      <p class="container-x py-5 text-sm">© {new Date().getFullYear()} {company.name}. Tüm hakları saklıdır.</p>
    </div>
  </footer>

  <!-- Sabit WhatsApp düğmesi: mobilde yuvarlak (alt çubuğun üstünde), masaüstünde yazılı -->
  <a href={company.whatsapp.href} target="_blank" rel="noopener" class="wa-attention fixed bottom-[calc(5.5rem+env(safe-area-inset-bottom))] right-4 z-40 flex size-14 items-center justify-center gap-2 rounded-full bg-whatsapp font-semibold text-white shadow-lg transition hover:bg-whatsapp-dark md:bottom-6 md:right-6 md:size-auto md:py-3 md:pl-4 md:pr-5" aria-label="WhatsApp ile yazın (yeni sekmede açılır)"><Icon name="whatsapp" class="size-8 md:size-6" /><span class="hidden md:inline">WhatsApp</span></a>

  <!-- Mobil sabit eylem çubuğu (WhatsApp sağ alttaki yuvarlak düğmede) -->
  <nav aria-label="Hızlı iletişim" class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgb(8_37_56/0.08)] backdrop-blur md:hidden">
    <div class="grid grid-cols-2 gap-3">
      <a href={company.phone.href} class="flex h-12 items-center justify-center gap-2 rounded-xl border border-brand-200 bg-brand-50 font-semibold text-brand-800 active:bg-brand-100"><Icon name="phone" class="size-5" /> Hemen Ara</a>
      <a href="/iletisim/#teklif-formu" class="flex h-12 items-center justify-center gap-2 rounded-xl bg-accent-600 font-semibold text-white shadow-sm active:bg-accent-700">Teklif Al <Icon name="arrow" class="size-5" /></a>
    </div>
  </nav>
</body>
</html>
