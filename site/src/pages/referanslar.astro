---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { references, sectors, type Sector } from '../data/site';

const used = sectors.filter((s) => references.some((r) => r.sector === s));
const featured = references.filter((r) => r.featured);

// Sektör ikonları (Phosphor duotone)
const sectorIcon: Record<Sector, string> = {
  Sanayi: 'factory',
  'Sağlık': 'hospital',
  Otel: 'hotel',
  'Telekom ve Bilişim': 'telecom',
  'Enerji ve Altyapı': 'energy',
  'Kamu ve Savunma': 'defense',
  'Lojistik ve Havacılık': 'aviation',
};

// Rakamlar yalnızca referans listesinden hesaplanır (yeni bilgi eklenmez).
const countries = new Set(references.map((r) => (r.location.includes(',') ? r.location.split(',').pop()!.trim() : 'Türkiye')));
const stats = [
  { value: references.length, label: 'Referans proje', icon: 'briefcase' },
  { value: used.length, label: 'Farklı sektör', icon: 'area' },
  { value: countries.size, label: 'Ülke', detail: [...countries].join(', '), icon: 'globe' },
];
---
<Layout title="Referanslar" description="Axis Teknik'in sanayi, sağlık, otel, enerji, telekom ve lojistik alanlarında tamamladığı elektrik ve yangın sistemleri projeleri.">
  <PageHero eyebrow="Referanslar" title="Referanslarımız" lead="Türkiye'de ve yurt dışında tamamladığımız elektrik, mekanik ve yangın sistemleri işlerinden seçmeler." image="referanslar" />

  <!-- Özet rakamlar -->
  <section class="container-x relative z-10 -mt-10">
    <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 shadow-xl shadow-brand-950/10">
      {stats.map((s) => (
        <div class="flex flex-col items-center gap-2 bg-white p-4 text-center sm:flex-row sm:gap-4 sm:p-6 sm:text-left">
          <span class="hidden size-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700 sm:flex"><Icon name={s.icon} class="size-7" /></span>
          <div class="flex flex-col-reverse">
            <dt class="mt-1 text-sm text-slate-600">{s.label}{s.detail && <span class="hidden sm:inline"> ({s.detail})</span>}</dt>
            <dd class="font-heading text-3xl sm:text-4xl font-bold leading-none text-brand-900">{s.value}</dd>
          </div>
        </div>
      ))}
    </dl>
  </section>

  <!-- Öne çıkan projeler -->
  <section class="container-x py-20">
    <p class="eyebrow">Seçilmiş işler</p>
    <h2 class="section-title mt-2">Öne çıkan projeler</h2>
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((r) => (
        <li class="featured-card group relative flex flex-col overflow-hidden rounded-2xl bg-brand-950 p-7 text-white shadow-lg transition hover:-translate-y-1 hover:shadow-2xl">
          <div class="flex items-center justify-between gap-3">
            <span class="flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-accent-500 to-accent-700 shadow-md shadow-black/30"><Icon name={sectorIcon[r.sector]} class="size-7" /></span>
            <span class="rounded-full border border-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-100">{r.sector}</span>
          </div>
          <h3 class="mt-6 text-xl font-bold leading-snug">{r.title}</h3>
          <p class="mt-2 flex-1 text-brand-100">{r.scope}</p>
          <p class="mt-6 flex items-center gap-2 border-t border-white/10 pt-4 text-sm text-brand-200"><Icon name="pin" class="size-4" />{r.location}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Tüm referanslar -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="container-x py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Tam liste</p>
          <h2 class="section-title mt-2">Tüm referanslar</h2>
        </div>
        <p class="text-sm text-slate-600" aria-live="polite"><span id="sayac" class="font-semibold text-ink">{references.length}</span> proje gösteriliyor</p>
      </div>

      <div role="group" aria-label="Sektöre göre süz" class="-mx-4 mt-8 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0" id="filtre">
        <button type="button" data-sector="" aria-pressed="true" class="chip">Tümü <span class="chip-count">{references.length}</span></button>
        {used.map((s) => (
          <button type="button" data-sector={s} aria-pressed="false" class="chip"><Icon name={sectorIcon[s]} class="size-4" />{s} <span class="chip-count">{references.filter((r) => r.sector === s).length}</span></button>
        ))}
      </div>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="liste">
        {references.map((r) => (
          <li data-sector={r.sector} class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700"><Icon name={sectorIcon[r.sector]} class="size-6" /></span>
            <div class="min-w-0">
              <h3 class="font-bold leading-snug">{r.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{r.scope}</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium text-slate-500">
                <span class="inline-flex items-center gap-1"><Icon name="pin" class="size-3.5" />{r.location}</span>
                <span class="text-accent-700">{r.sector}</span>
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  @reference "../styles/global.css";
  .featured-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / .04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / .04) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom left, black, transparent 70%);
    pointer-events: none;
  }
  .featured-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent-500), var(--color-brand-500));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .4s ease;
  }
  .featured-card:hover::after { transform: scaleX(1); }
  .chip { @apply inline-flex shrink-0 cursor-pointer items-center gap-2 whitespace-nowrap rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium transition hover:border-brand-600 hover:text-brand-700; }
  .chip-count { @apply rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600; }
  .chip[aria-pressed='true'] { @apply border-brand-700 bg-brand-700 text-white; }
  .chip[aria-pressed='true'] .chip-count { @apply bg-white/20 text-white; }
  @media (prefers-reduced-motion: reduce) {
    .featured-card, .featured-card::after { transition: none; }
  }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#filtre button');
  const items = document.querySelectorAll<HTMLElement>('#liste li');
  const counter = document.getElementById('sayac');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const s = b.dataset.sector;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let n = 0;
    items.forEach((li) => { li.hidden = !!s && li.dataset.sector !== s; if (!li.hidden) n++; });
    if (counter) counter.textContent = String(n);
  }));
</script>
