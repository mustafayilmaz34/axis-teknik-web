---
// Misyon ve vizyon kartları. variant="band": Hakkımızda'daki koyu tam genişlik bölüm; "compact": ana sayfa
import Icon from './Icon.astro';
import { company } from '../data/site';

interface Props { variant?: 'band' | 'compact' }
const { variant = 'band' } = Astro.props;
const items = [
  { title: 'Misyonumuz', text: company.mission, icon: 'mission', accent: false },
  { title: 'Vizyonumuz', text: company.vision, icon: 'vision', accent: true },
];
---
{variant === 'band' ? (
  <section class="mv-band bg-brand-950 text-white">
    <div class="container-x py-16 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent-300">Neden varız, nereye gidiyoruz</p>
      <h2 class="section-title mt-2">Misyon ve vizyonumuz</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {items.map((m) => (
          <article class="relative overflow-hidden rounded-3xl bg-white/5 p-8 ring-1 ring-white/10 backdrop-blur sm:p-10">
            <Icon name={m.icon} class="pointer-events-none absolute -bottom-8 -right-6 size-44 text-white/5" />
            <span class:list={['relative flex size-14 items-center justify-center rounded-2xl text-white shadow-lg', m.accent ? 'bg-linear-to-br from-accent-500 to-accent-700' : 'bg-linear-to-br from-brand-500 to-brand-700']}><Icon name={m.icon} class="size-8" /></span>
            <h3 class="relative mt-6 font-heading text-2xl font-bold">{m.title}</h3>
            <p class="relative mt-3 text-lg leading-relaxed text-brand-100">{m.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
) : (
  <dl class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    {items.map((m) => (
      <div class="flex gap-4 p-5">
        <span class:list={['flex size-11 shrink-0 items-center justify-center rounded-xl text-white', m.accent ? 'bg-accent-600' : 'bg-brand-700']}><Icon name={m.icon} class="size-6" /></span>
        <div>
          <dt class="font-heading text-lg font-bold text-ink">{m.title}</dt>
          <dd class="mt-1 text-slate-600">{m.text}</dd>
        </div>
      </div>
    ))}
  </dl>
)}

<style>
  .mv-band {
    background-image:
      radial-gradient(circle at 0% 0%, rgb(0 140 208 / .25), transparent 45%),
      radial-gradient(circle at 100% 100%, rgb(233 76 9 / .18), transparent 45%);
  }
</style>
