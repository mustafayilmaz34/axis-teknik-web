---
// Öne çıkan projeler: ana sayfa ve Referanslar sayfasında ortak kart tasarımı
import Icon from './Icon.astro';
import type { Reference } from '../data/site';
import { sectorIcon, workTags } from '../data/sectorIcons';

interface Props { projects: Reference[] }
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {projects.map((r, i) => (
    <li class="project-card group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-950/10">
      <!-- Proje bandı -->
      <div class="project-band relative flex h-44 flex-col justify-between overflow-hidden bg-brand-950 p-5 text-white">
        <Icon name={sectorIcon[r.sector]} class="band-icon pointer-events-none absolute -bottom-6 -right-4 size-40 text-white/10 transition duration-500" />
        <div class="relative flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/10 py-1 pl-1.5 pr-3 text-xs font-semibold uppercase tracking-wider ring-1 ring-white/15 backdrop-blur">
            <span class="flex size-6 items-center justify-center rounded-full bg-accent-600"><Icon name={sectorIcon[r.sector]} class="size-4" /></span>
            {r.sector}
          </span>
          <span class="font-heading text-sm font-bold tracking-widest text-white/50">{pad(i + 1)}</span>
        </div>
        <p class="relative flex items-center gap-1.5 text-sm font-medium text-brand-100"><Icon name="pin" class="size-4 text-accent-300" />{r.location}</p>
      </div>
      <!-- Proje bilgisi -->
      <div class="flex flex-1 flex-col p-6">
        <h3 class="font-heading text-xl font-bold leading-snug text-ink">{r.title}</h3>
        <p class="mt-2 flex-1 text-slate-600">{r.scope}</p>
        <ul class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
          {workTags(r.scope).map((t) => (
            <li class:list={['rounded-md px-2.5 py-1 text-xs font-semibold', t.fire ? 'bg-accent-50 text-accent-700' : 'bg-brand-50 text-brand-800']}>{t.label}</li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ul>

<style>
  .project-band {
    background-image:
      radial-gradient(circle at 100% 0%, rgb(233 76 9 / .35), transparent 55%),
      linear-gradient(rgb(255 255 255 / .05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / .05) 1px, transparent 1px);
    background-size: auto, 24px 24px, 24px 24px;
  }
  .project-card:hover :global(.band-icon) { transform: scale(1.08) rotate(-4deg); color: rgb(255 255 255 / .16); }
  @media (prefers-reduced-motion: reduce) {
    .project-card, .project-card :global(.band-icon) { transition: none; }
    .project-card:hover { transform: none; }
    .project-card:hover :global(.band-icon) { transform: none; }
  }
</style>
